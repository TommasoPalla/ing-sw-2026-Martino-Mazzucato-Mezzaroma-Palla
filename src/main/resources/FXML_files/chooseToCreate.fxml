<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.View.GUIView.GuiControllers.ChooseToCreateController">
   <children>
      <Label layoutX="88.0" layoutY="64.0" text="Do you want to create or to join a game?">
         <font>
            <Font name="Calibri Bold Italic" size="25.0" />
         </font>
      </Label>
      <HBox alignment="CENTER" layoutX="31.0" layoutY="200.0" prefHeight="100.0" prefWidth="540.0" spacing="100.0">
         <children>
            <Button fx:id="ChangeNick" mnemonicParsing="false" onAction="#handleNick" prefHeight="56.0" prefWidth="140.0" text="Change nickName" />
            <Button fx:id="Create" mnemonicParsing="false" onAction="#handleCreate" prefHeight="56.0" prefWidth="140.0" text="Create a Game" />
            <Button fx:id="Join" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#handleJoin" prefHeight="56.0" prefWidth="140.0" text="Join a Game" textAlignment="CENTER" />
         </children>
      </HBox>
   </children>
</AnchorPane>
