<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.View.GUIView.GuiControllers.connectionTypeSceneController">
   <children>
      <Label layoutX="177.0" layoutY="79.0" text="Choose connection type">
         <font>
            <Font name="Calibri Bold Italic" size="25.0" />
         </font>
      </Label>
      <HBox alignment="CENTER" layoutX="61.0" layoutY="150.0" prefHeight="100.0" prefWidth="479.0" spacing="100.0">
         <children>
            <Button fx:id="RMIButton" mnemonicParsing="false" onAction="#handleRMI" prefHeight="50.0" prefWidth="70.0" text="RMI" />
            <Button fx:id="SocketButton" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#handleSocket" prefHeight="50.0" prefWidth="70.0" text="Socket" textAlignment="CENTER" />
         </children>
      </HBox>
   </children>
</AnchorPane>
