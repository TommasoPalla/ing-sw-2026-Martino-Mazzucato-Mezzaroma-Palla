<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>

<?import javafx.scene.layout.BorderPane?>
<?import org.controlsfx.control.cell.ImageGridCell?>
<?import javafx.scene.control.Button?>

<?import javafx.scene.layout.Region?>
<AnchorPane fx:id="mainAnchor" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="it.polimi.ingsw.View.GUIView.Controllers.GameSceneController"
            styleClass="main-background">
   <stylesheets>
      <URL value="@/css/gameSceneStyle.css"/>
   </stylesheets>
   <BorderPane AnchorPane.topAnchor="100"
               AnchorPane.bottomAnchor="90"
               AnchorPane.leftAnchor="40"
               AnchorPane.rightAnchor="310">
      <fx:include fx:id="gameBoard"
                  source="GameBoard.fxml"/>
   </BorderPane>


   <HBox fx:id="statusBar" AnchorPane.topAnchor="10"
         AnchorPane.leftAnchor="20"
         AnchorPane.rightAnchor="20"
         alignment="TOP_CENTER"> <Region HBox.hgrow="ALWAYS"/>

      <HBox spacing="20"
            alignment="CENTER"
            styleClass="status-bar">
         <padding>
            <Insets top="5" bottom="5" right="15" left="15" />
         </padding>
         <VBox spacing="15" alignment="CENTER">
            <Label text="ERA" />
            <Label fx:id="eraStatus" text="I" />
         </VBox>
         <VBox spacing="15" alignment="CENTER">
            <Label text="ROUND" />
            <Label fx:id="roundStatus" text="1"/>
         </VBox>
         <VBox spacing="15" alignment="CENTER">
            <Label text="PHASE" />
            <Label fx:id="phaseStatus" text="Start Game" />
         </VBox>
         <VBox spacing="15" alignment="CENTER">
            <Label text="ACTIVE PLAYER" />
            <Label fx:id="playerStatus"/>
         </VBox>
      </HBox>

      <Region HBox.hgrow="ALWAYS" />
      <Button fx:id="leaveGameBtn" styleClass="leave-game-btn" alignment="CENTER_RIGHT"
              text="Leave Game" onAction="#handleLeaveGame" />
   </HBox>


   <ScrollPane fx:id="rightMenu" prefWidth="270"
               fitToWidth="true" styleClass="transparent-scroll"
               AnchorPane.rightAnchor="20" AnchorPane.topAnchor="75" AnchorPane.bottomAnchor="70"
               hbarPolicy="NEVER">
      <VBox fx:id="infoBoard" spacing="10" alignment="TOP_CENTER" styleClass="info-board"/>
   </ScrollPane>


   <VBox fx:id="tribeRegion" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="300"
         maxWidth="860" prefWidth="860" maxHeight="380" prefHeight="380"
         styleClass="tribe-region" spacing="10">
      <padding>
         <Insets top="15.0" bottom="15.0" left="20.0" right="20.0"/>
      </padding>
      <HBox fx:id="tribeHeader" alignment="TOP_CENTER" spacing="15" style="-fx-cursor: hand">

         <HBox spacing="15" alignment="CENTER_LEFT">
            <ImageView fitHeight="36" fitWidth="36" preserveRatio="true">
               <Image url="@/Images/Icons/Food.png"/>
            </ImageView>
            <Label fx:id="foodReserve" text="0" prefWidth="30" styleClass="tribe-label"/>
         </HBox>

         <HBox spacing="15" alignment="CENTER_LEFT">
            <ImageView fitHeight="36" fitWidth="36" preserveRatio="true">
               <Image url="@/Images/Icons/Prestige.png"/>
            </ImageView>
            <Label fx:id="prestigePoints" text="0" prefWidth="30" styleClass="tribe-label"/>
         </HBox>

         <HBox spacing="15" alignment="CENTER_LEFT">
            <ImageView fitHeight="36" fitWidth="36" preserveRatio="true">
               <Image url="@/Images/Icons/Characters.png"/>
            </ImageView>
            <Label fx:id="charactersNumber" text="0" prefWidth="30" styleClass="tribe-label"/>
         </HBox>

         <HBox>
            <padding>
               <Insets right="10" left="25"/>
            </padding>
            <Label text="My Tribe" style="-fx-font-weight: bold;" alignment="TOP_CENTER" prefWidth="120">
               <font>
                  <Font name="Segoe UI" size="22.0"/>
               </font>
            </Label>
         </HBox>


         <HBox spacing="10" alignment="CENTER_LEFT">
            <ImageView fitHeight="36" fitWidth="36" preserveRatio="true">
               <Image url="@/Images/Icons/Sustenance.png"/>
            </ImageView>
            <Label fx:id="sustenanceDiscount" text="0" prefWidth="20" styleClass="tribe-label"/>
         </HBox>

         <HBox spacing="10" alignment="CENTER_LEFT">
            <ImageView fitHeight="36" fitWidth="36" preserveRatio="true">
               <Image url="@/Images/Icons/BuildingsDiscount.png"/>
            </ImageView>
            <Label fx:id="buildingsDiscount" text="0" prefWidth="20" styleClass="tribe-label"/>
         </HBox>

         <HBox spacing="10" alignment="CENTER_LEFT">
            <ImageView fitHeight="36" fitWidth="36" preserveRatio="true">
               <Image url="@/Images/Icons/ShamanStar.png"/>
            </ImageView>
            <Label fx:id="shamanStars" text="0" prefWidth="20" styleClass="tribe-label"/>
         </HBox>

         <HBox spacing="10" alignment="CENTER_LEFT">
            <ImageView fitWidth="36" fitHeight="36" preserveRatio="true">
               <Image url="@/Images/Icons/Inventions.png" />
            </ImageView>
            <Label fx:id="distinctInventions" text="0" prefWidth="20" styleClass="tribe-label"/>
         </HBox>

      </HBox>


      <HBox fx:id="myTribe" spacing="20.0" alignment="CENTER"
            prefWidth="860" maxWidth="860" prefHeight="300">
         <padding>
            <Insets top="15.0" bottom="10.0" left="10.0" right="10.0"/>
         </padding>

         <VBox spacing="10" alignment="TOP_CENTER">
            <HBox spacing="5" alignment="CENTER" prefWidth="113">
               <ImageView fitHeight="24" fitWidth="24" preserveRatio="true">
                  <Image url="@/Images/Icons/Hunter.png"/>
               </ImageView>
               <Label fx:id="huntersNumber" text="0" styleClass="tribe-column-label"/>
            </HBox>
            <VBox fx:id="hunterColumn" prefWidth="113" prefHeight="270" maxHeight="270" spacing="-70"/>
         </VBox>

         <VBox spacing="10" alignment="TOP_CENTER">
            <HBox spacing="5" alignment="CENTER" prefWidth="113">
               <ImageView fitHeight="24" fitWidth="24" preserveRatio="true">
                  <Image url="@/Images/Icons/Builder.png"/>
               </ImageView>
               <Label fx:id="buildersNumber" text="0" styleClass="tribe-column-label"/>
            </HBox>
            <VBox fx:id="builderColumn" prefWidth="113" prefHeight="270" maxHeight="270" spacing="-70"/>
         </VBox>

         <VBox spacing="10" alignment="TOP_CENTER">
            <HBox spacing="5" alignment="CENTER" prefWidth="113">
               <ImageView fitHeight="24" fitWidth="24" preserveRatio="true">
                  <Image url="@/Images/Icons/Gatherer.png"/>
               </ImageView>
               <Label fx:id="gatherersNumber" text="0" styleClass="tribe-column-label"/>
            </HBox>
            <VBox fx:id="gathererColumn" prefWidth="113" prefHeight="270" maxHeight="270" spacing="-70"/>
         </VBox>

         <VBox spacing="10" alignment="TOP_CENTER">
            <HBox spacing="5" alignment="CENTER" prefWidth="113">
               <ImageView fitHeight="24" fitWidth="24" preserveRatio="true">
                  <Image url="@/Images/Icons/Artist.png"/>
               </ImageView>
               <Label fx:id="artistsNumber" text="0" styleClass="tribe-column-label"/>
            </HBox>
            <VBox fx:id="artistColumn" prefWidth="113" prefHeight="270" maxHeight="270" spacing="-70"/>
         </VBox>

         <VBox spacing="10" alignment="TOP_CENTER">
            <HBox spacing="5" alignment="CENTER" prefWidth="113">
               <ImageView fitHeight="24" fitWidth="24" preserveRatio="true">
                  <Image url="@/Images/Icons/Shaman.png"/>
               </ImageView>
               <Label fx:id="shamansNumber" text="0" styleClass="tribe-column-label"/>
            </HBox>
            <VBox fx:id="shamanColumn" prefWidth="113" prefHeight="270" maxHeight="270" spacing="-70"/>
         </VBox>

         <VBox spacing="10" alignment="TOP_CENTER">
            <HBox spacing="5" alignment="CENTER" prefWidth="113">
               <ImageView fitHeight="24" fitWidth="24" preserveRatio="true">
                  <Image url="@/Images/Icons/Inventor.png"/>
               </ImageView>
               <Label fx:id="inventorsNumber" text="0" styleClass="tribe-column-label"/>
            </HBox>
            <VBox fx:id="inventorColumn" prefWidth="113" prefHeight="270" maxHeight="270" spacing="-70"/>
         </VBox>

         <VBox spacing="10" alignment="CENTER" prefWidth="113">
            <Label text="Buildings" styleClass="tribe-column-label"/>
            <VBox fx:id="buildingColumn" prefWidth="113" prefHeight="270" maxHeight="270" spacing="-70"/>
         </VBox>

      </HBox>
   </VBox>
</AnchorPane>