<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.View.GUIView.GuiControllers.ChooseTotemController">
   <children>
      <Text layoutX="219.0" layoutY="85.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Choose your totem">
         <font>
            <Font name="Californian FB Italic" size="25.0" />
         </font>
      </Text>
      <HBox alignment="CENTER" layoutX="1.0" layoutY="150.0" prefHeight="100.0" prefWidth="600.0" spacing="60.0">
         <children>
            <Button fx:id="whiteButton" mnemonicParsing="false" onAction="#handleWhite" text="white" />
            <Button fx:id="redButton" mnemonicParsing="false" onAction="#handleRed" text="red" textAlignment="CENTER" />
            <Button fx:id="purpleButton" mnemonicParsing="false" onAction="#handlePurple" text="purple" />
            <Button fx:id="yellowButton" mnemonicParsing="false" onAction="#handleYellow" text="yellow" />
            <Button fx:id="blueButton" mnemonicParsing="false" onAction="#handleBlue" text="blue" />
         </children>
      </HBox>
      <HBox alignment="CENTER" layoutY="250.0" prefHeight="100.0" prefWidth="600.0" spacing="45.0">
         <children>
            <Circle fill="#1f93ff00" radius="31.0" stroke="BLACK" strokeType="INSIDE" />
            <Circle fill="#ff1f1fbf" layoutX="41.0" layoutY="41.0" radius="31.0" stroke="BLACK" strokeType="INSIDE" />
            <Circle fill="#480d5b" layoutX="103.0" layoutY="41.0" radius="31.0" stroke="BLACK" strokeType="INSIDE" />
            <Circle fill="#f8ff1fb8" layoutX="165.0" layoutY="41.0" radius="31.0" stroke="BLACK" strokeType="INSIDE" />
            <Circle fill="DODGERBLUE" layoutX="227.0" layoutY="41.0" radius="31.0" stroke="BLACK" strokeType="INSIDE" />
         </children>
      </HBox>
      <Label fx:id="errorLabel" layoutX="151.0" layoutY="129.0" textFill="#fc0f0fba">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
